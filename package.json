{
  "name": "ability-growth-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p functions/tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply ability_growth --local",
    "db:migrate:remote": "wrangler d1 migrations apply ability_growth --remote"
  },
  "dependencies": {
    "@shared/core": "file:../shared-core",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.400.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.19",
    "oxlint": "^1.75.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
